# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is tracked in git.

# Postgres connection string from Neon (or any Postgres provider).
# Neon: dashboard -> your project -> Connect -> copy the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared-secret gate for the admin-only booking endpoints (approve/decline/
# pending/expire-stale) — a stand-in until Phase 7 builds real admin auth.
# Send it as the `x-admin-key` header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=""

# Filled in during Phase 4 (payments) — Razorpay dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Filled in during Phase 5 (notifications).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
RESEND_API_KEY=""

# Filled in during Phase 6 (calling).
DAILY_API_KEY=""
