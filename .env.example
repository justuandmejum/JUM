# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is tracked in git.

# Postgres connection string from Neon (or any Postgres provider).
# Neon: dashboard -> your project -> Connect -> copy the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared-secret gate for admin-only endpoints, for scripts and the future
# Azure Function timer trigger (expire-stale) — not a logged-in browser, so
# they use this instead of a session cookie. Send as the `x-admin-key`
# header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=""

# Signs the admin dashboard's session cookie (Phase 7). Same generation
# method as ADMIN_API_KEY above, just a different secret — don't reuse one
# for the other.
ADMIN_SESSION_SECRET=""

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Razorpay dashboard -> Settings ->
# API Keys. RAZORPAY_WEBHOOK_SECRET is one we choose ourselves (same
# generation method as ADMIN_API_KEY above) and then paste into Razorpay
# dashboard -> Settings -> Webhooks when registering the webhook URL —
# needs a public HTTPS endpoint, so that step waits until after deploy.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Filled in during Phase 5 (notifications).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
RESEND_API_KEY=""

# Filled in during Phase 6 (calling).
DAILY_API_KEY=""
